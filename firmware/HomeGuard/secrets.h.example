#ifndef SECRETS_H
#define SECRETS_H

// =====================================================
// 本文件是模板，不是真实配置。
//
// 使用方法：把本文件复制为同目录下的 secrets.h，填入自己的真实值。
// secrets.h 已在 .gitignore 中排除，不会被提交到版本库。
// =====================================================


// ---------- WiFi ----------
#define WIFI_SSID           "your-wifi-ssid"
#define WIFI_PASSWORD       "your-wifi-password"


// ---------- OneNET MQTT ----------
// 在 OneNET 控制台创建产品与设备后获取
#define ONENET_PRODUCT_ID   "your-product-id"
#define ONENET_DEVICE_NAME  "your-device-name"
#define ONENET_TOKEN        "your-onenet-token"


// ---------- GitHub（可选） ----------
// 用于报警时触发本仓库的 repository_dispatch，让 PWA 侧刷新数据。
// 留空字符串即关闭该功能。
//
// 注意：该 Token 需要仓库写权限，一旦泄露风险较高。
// 建议保持为空，改用云端主动拉取的方式获取数据。
#define GITHUB_TOKEN        ""

#endif
